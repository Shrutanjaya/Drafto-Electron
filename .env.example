# Firebase Web App Configuration
# Copy this file to .env and fill in your values from Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth (optional — enables "Sign in with Google" on the login page)
# Create a Desktop app OAuth 2.0 client in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Add "drafto://auth-callback" as an Authorized Redirect URI.
VITE_GOOGLE_CLIENT_ID=
