{
  "name": "drafto-electron",
  "version": "1.0.23",
  "description": "Drafto - Supreme Court SLP Drafting Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "publish:win": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "drafto",
    "legal",
    "slp",
    "supreme-court"
  ],
  "author": "Quindoph Legal Pvt. Ltd.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shrutanjaya/Drafto-Electron.git"
  },
  "build": {
    "appId": "com.drafto.app",
    "productName": "DraftoSLP",
    "afterSign": "afterSign.js",
    "asar": true,
    "compression": "maximum",
    "copyright": "Copyright © 2025 Quindoph Legal Pvt. Ltd.",
    "publish": {
      "provider": "github",
      "owner": "Shrutanjaya",
      "repo": "Drafto-Electron"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../Firebase Files/.next/standalone",
        "to": "app/Firebase Files/.next/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Firebase Files/.next/static",
        "to": "app/Firebase Files/.next/standalone/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Firebase Files/public",
        "to": "app/Firebase Files/.next/standalone/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Firebase Files/python_scripts",
        "to": "app/Firebase Files/python_scripts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "resources/app/Firebase Files/.next/standalone/**/*",
      "resources/app/Firebase Files/python_scripts/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "publisherName": "Drafto Team",
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "legalTrademarks": "Drafto is a trademark of Drafto Team",
      "fileAssociations": [
        {
          "ext": "drafto",
          "name": "Drafto Project",
          "description": "Drafto Project File",
          "icon": "build/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Drafto",
      "license": "LICENSE.txt",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "runAfterFinish": false,
      "menuCategory": true,
      "allowElevation": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "warningsAsErrors": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "python/",
        "\\.pyc$",
        "\\.py$"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@electron/notarize": "^2.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
