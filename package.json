{
  "name": "drafto-slp",
  "version": "1.1.6",
  "private": true,
  "author": "Shrutanjaya Bhardwaj",
  "description": "DraftoSLP – Supreme Court petition drafting tool",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-paragraph": "^2.5.8",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.5.8",
    "@tiptap/extension-underline": "^2.5.8",
    "@tiptap/pm": "^2.5.8",
    "@tiptap/react": "^2.5.8",
    "@tiptap/starter-kit": "^2.5.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.9.1",
    "html-to-text": "^9.0.5",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.475.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.20",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-resizable-panels": "^2.0.21",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tmp": "^0.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@electron/notarize": "^3.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/tmp": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.drafto.slp",
    "productName": "DraftoSLP",
    "afterSign": "./afterSign.js",
    "beforePack": "./beforePack.js",
    "asar": true,
    "compression": "maximum",
    "copyright": "Copyright © 2026 Quindoph Legal Solutions Pvt. Ltd.",
    "publish": {
      "provider": "github",
      "owner": "Shrutanjaya",
      "repo": "Drafto-Electron"
    },
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "!build/libreoffice-staging/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "python_scripts",
          "to": "python_scripts",
          "filter": [
            "**/*"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": "drafto",
          "name": "Drafto Project",
          "description": "Drafto Project File",
          "icon": "build/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DraftoSLP",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE.txt",
      "deleteAppDataOnUninstall": false,
      "menuCategory": true,
      "warningsAsErrors": false
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Savita Gour (5Q5VXZ5Z43)",
      "notarize": false,
      "signIgnore": [
        "python/",
        "\\.pyc$",
        "\\.py$"
      ],
      "extraResources": [
        {
          "from": "build/libreoffice-staging/LibreOffice.app",
          "to": "LibreOffice.app",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/licenses",
          "to": "licenses",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Drafto Project",
            "CFBundleTypeExtensions": [
              "drafto"
            ],
            "CFBundleTypeRole": "Editor"
          }
        ]
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
